# ==============================================================================
# JobPilot Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Authentication (NextAuth / Auth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=jobpilot-super-secret-random-key-change-in-production-32chars

# Google OAuth2 & Cloud Pub/Sub Integration
# Scopes: openid, userinfo.email, userinfo.profile, gmail.readonly, gmail.send, gmail.compose, calendar.events, calendar.freebusy
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/gmail-push-notifications
GOOGLE_PUBSUB_SUBSCRIPTION=projects/your-gcp-project-id/subscriptions/gmail-push-sub
GOOGLE_CASA_ASSESSMENT_MODE=TIER_2

# Data Storage (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://jobpilot:jobpilot_secret@localhost:5432/jobpilot_db

# Message Broker & Cache (Redis 7.2)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO for local development)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=jobpilot-assets
S3_REGION=us-east-1

# AI LLM Services (Anthropic Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & PII Encryption (32-byte hex for AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Contact Enrichment (Hunter.io / Apollo API)
HUNTER_API_KEY=your-hunter-api-key
APOLLO_API_KEY=your-apollo-api-key

# Browser Automation & Stealth Mode
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000
MAX_APPLICATIONS_PER_HOUR=5
GLOBAL_DAILY_APPLY_CAP=20
