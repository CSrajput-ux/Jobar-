# ==============================================================================
# JobPilot / Jobar - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env and configure values before starting services.

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="JobPilot API"
VERSION="0.2.0"
API_V1_STR="/api/v1"

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Relational Persistence (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://jobpilot:replace_with_strong_password@localhost:5432/jobpilot_db
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=jobpilot_db

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Security & Master Encryption Key
# In production, ENCRYPTION_MASTER_KEY MUST be a 64-character hex string (32 bytes AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Integration (Anthropic Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Workspace Integration (OAuth 2.0 PKCE for Gmail & Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Object Storage (MinIO / S3 for resumes, proofs, artifacts)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_with_minio_secret
S3_BUCKET_NAME=jobpilot-assets

# Recruiter Discovery Providers
HUNTER_API_KEY=
APOLLO_API_KEY=

# Automation Governance & Safety Caps
MAX_APPLICATIONS_PER_HOUR=5
GLOBAL_DAILY_APPLY_CAP=15
OUTREACH_DAILY_CAP=10
