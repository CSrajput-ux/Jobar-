# ==============================================================================
# JobPilot Production Environment Configuration
# ==============================================================================

ENVIRONMENT=production
PROJECT_NAME="JobPilot Enterprise Core"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=jobpilot_admin
POSTGRES_PASSWORD=generate_a_super_strong_password_here_32chars
POSTGRES_DB=jobpilot_prod_db
DATABASE_URL=postgresql+asyncpg://jobpilot_admin:generate_a_super_strong_password_here_32chars@postgres:5432/jobpilot_prod_db

# High-Concurrency Connection Pooling (50,000 RPS Target)
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Redis In-Memory Cache & Celery Broker
REDIS_URL=redis://redis:6379/0

# Production Security & Master Encryption Key
# MUST BE EXACTLY 64 HEX CHARACTERS (32 BYTES)
# Generate via: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS & Domain Configuration
CORS_ORIGINS=https://jobpilot.ai,https://app.jobpilot.ai
NEXT_PUBLIC_API_URL=/api/v1

# MinIO / S3 Production Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_prod_user
S3_SECRET_KEY=generate_minio_strong_secret_key_here
S3_BUCKET_NAME=jobpilot-production-assets

# AI Services
ANTHROPIC_API_KEY=sk-ant-api-prod-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Rate Limits & Compliance
MAX_APPLICATIONS_PER_HOUR=5
GLOBAL_DAILY_APPLY_CAP=25
OUTREACH_DAILY_CAP=20
