# Jobar V2 environment template
# Never commit a real secret or production credential.

ENVIRONMENT=development
PROJECT_NAME=Jobar API
VERSION=0.1.0
API_V1_STR=/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

DATABASE_URL=postgresql://jobpilot:replace-me@localhost:5432/jobpilot_db
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=jobpilot_db
REDIS_URL=redis://localhost:6379/0

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ENCRYPTION_MASTER_KEY=replace-with-32-byte-hex-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-me
S3_BUCKET_NAME=jobpilot-assets

HUNTER_API_KEY=
APOLLO_API_KEY=
MAX_APPLICATIONS_PER_HOUR=5
GLOBAL_DAILY_APPLY_CAP=20
